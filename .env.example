# Copy to .env (gitignored) and fill in your own values.
# manage.py loads this at startup before Django settings are imported.

# --- LLM provider ---------------------------------------------------------
# Pick one. Auto-detection order: LLM_PROVIDER → OLLAMA_HOST/LLM_BASE_URL →
# ANTHROPIC_API_KEY → OPENAI_API_KEY → local probe → MockLLM.
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...

# Local (Ollama / LM Studio / vLLM) — OpenAI-compatible endpoint
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# --- Runtime knobs --------------------------------------------------------
# RAG_QUERY_WORKERS=8
# ABLATION_WORKERS=4
# KG_CACHE_DIR=data/kg_cache
